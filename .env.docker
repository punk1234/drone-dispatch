# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=drone_user
POSTGRES_PASSWORD=drone_pass
POSTGRES_DB=drone_dispatch
DATABASE_URL=postgresql://drone_user:drone_pass@postgres:5432/drone_dispatch

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── AWS S3 / LocalStack ───────────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_S3_BUCKET=drone-dispatch-uploads
S3_PUBLIC_URL=http://localhost:4566

# ── API Keys ──────────────────────────────────────────────────────────────
ADMIN_API_KEY=dd-admin-k9x2mP7qL4nW8vT3
READONLY_API_KEY=dd-readonly-rJ5yH6bN1cQ2sA9

# ── Battery audit cron (every minute) ────────────────────────────────────
BATTERY_AUDIT_CRON=* * * * *

# ── Redis cache TTL (seconds) ────────────────────────────────────────────
CACHE_TTL=30

# ── Pre-signed URL expiry (seconds) ──────────────────────────────────────
PRESIGNED_URL_EXPIRES=300

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_STRICT=20
RATE_LIMIT_MAX_GENERAL=100
# Uncomment below to disable rate limiting during testing:
# RATE_LIMIT_MAX_STRICT=10000
# RATE_LIMIT_MAX_GENERAL=10000
