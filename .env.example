PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://drone_user:drone_pass@localhost:5432/drone_dispatch
POSTGRES_USER=drone_user
POSTGRES_PASSWORD=drone_pass
POSTGRES_DB=drone_dispatch

# Redis
REDIS_URL=redis://localhost:6379

# Battery audit cron (default: every minute)
BATTERY_AUDIT_CRON=* * * * *

# Redis cache TTL in seconds
CACHE_TTL=30

# Upload directory

# AWS S3 / LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_S3_BUCKET=drone-dispatch-uploads
# Public URL used in stored imageUrls (localhost for dev, CloudFront/S3 domain for prod)
S3_PUBLIC_URL=http://localhost:4566

# API Keys
# Admin key — full access (register drones, load, update state, create medications)
ADMIN_API_KEY=dd-admin-k9x2mP7qL4nW8vT3

# Readonly key — GET endpoints only
READONLY_API_KEY=dd-readonly-rJ5yH6bN1cQ2sA9

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Rate limiting (per API key)
# Window duration in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window for mutating endpoints (POST, PATCH, PUT)
RATE_LIMIT_MAX_STRICT=20
# Max requests per window for read endpoints (GET)
RATE_LIMIT_MAX_GENERAL=100
# To effectively disable rate limiting during local testing:
# RATE_LIMIT_MAX_STRICT=10000
# RATE_LIMIT_MAX_GENERAL=10000
